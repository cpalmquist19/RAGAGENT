    {
      "kind": "paragraph",
      "text": "This Policy establishes the requirements for an administrator to renew a continuing professional license.",
      "depth": 0,
      "path": null,
      "label": null,
      "heading": null,
      "section": "Policy Statement",
      "rows": null
    },
    {
      "kind": "heading",
      "text": "Policy",
      "depth": 0,
      "path": null,
      "label": null,
      "heading": null,
      "section": null,
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "Each person holding an administrator license must renew that license every five years.",
      "depth": 0,
      "path": "1",
      "label": "1.",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "Administrators must complete eight CEUs during each renewal cycle consisting of the following:",
      "depth": 0,
      "path": "2",
      "label": "2.",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "Four CEUs focused on the administrator’s leadership role in instruction, human resources, and management.",
      "depth": 1,
      "path": "2(a)",
      "label": "(a)",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "Four general CEUs that are germane to the K-12 educational environment.",
      "depth": 1,
      "path": "2(b)",
      "label": "(b)",
      "heading": null,
      "section": "Policy",
      "rows": null
    }
