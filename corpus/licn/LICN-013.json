    {
      "kind": "paragraph",
      "text": "This Policy establishes the qualifications and procedures for adding a new license area to an existing initial professional license or continuing professional license.",
      "depth": 0,
      "path": null,
      "label": null,
      "heading": null,
      "section": "Policy Statement",
      "rows": null
    },
    {
      "kind": "heading",
      "text": "Policy",
      "depth": 0,
      "path": null,
      "label": null,
      "heading": null,
      "section": null,
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "An applicant may request to add a new license area to an existing IPL or CPL. An applicant may only add a license area to an IPL if the applicant has met the licensure examination requirements for the initial license area. To qualify for additional areas on a teaching license, the applicant shall:",
      "depth": 0,
      "path": "1",
      "label": "1.",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "Satisfy the applicable licensure examination requirements for that license area; or",
      "depth": 1,
      "path": "1(a)",
      "label": "(a)",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "Complete 24 credit hours of coursework from an institution of higher education in the license area and obtains a grade of C or better in each course.",
      "depth": 1,
      "path": "1(b)",
      "label": "(b)",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "For the following license areas, an applicant may only add that license area by satisfying the applicable licensure examination requirements and cannot add that license area through coursework alone:",
      "depth": 0,
      "path": "2",
      "label": "2.",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "Elementary Education",
      "depth": 1,
      "path": "2(a)",
      "label": "(a)",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "Exceptional Children: General Curriculum",
      "depth": 1,
      "path": "2(b)",
      "label": "(b)",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
    {
      "kind": "list_item",
      "text": "The Department of Public Instruction shall not add additional teaching license areas pursuant to Section 1 to the following license classifications:",
      "depth": 0,
      "path": "3",
      "label": "3.",
      "heading": null,
      "section": "Policy",
      "rows": null
    },
